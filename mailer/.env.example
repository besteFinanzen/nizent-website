# Copy these into your Dokploy project environment variables (DO NOT commit real values).
# The mailer is a separate Dokploy app reachable at https://api.nizent.de

PORT=3000

# Where the contact form POSTs to and who receives the mail
TO_EMAIL=kontakt@nizent.de
FROM_EMAIL=no-reply@nizent.de
FROM_NAME=nizent

# Site origin allowed to call this API (CORS)
ALLOWED_ORIGIN=https://nizent.de

# SMTP credentials for sending (ask your hoster for these)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kontakt@nizent.de
SMTP_PASS=change-me
